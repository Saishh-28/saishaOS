# Local secrets for the Cloudflare Worker (used by `npm run dev`).
# Copy this file to .dev.vars and fill it in. .dev.vars is git-ignored.
# In production, set the same names with `npx wrangler secret put <NAME>`.
#
# Note: when .dev.vars exists, Wrangler stops reading .env for the Worker,
# so the Supabase values must be repeated here.

# Google AI Studio > Get API key
GEMINI_API_KEY=""

# The same project as the browser app uses locally. For local testing that's
# your TEST project (the values in .env.development.local), marked as dev:
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_ENV="dev"
# Without SUPABASE_ENV="dev", the local server refuses /api/planner and /api/lumi
# calls. Only if you really mean to test against real data:
# ALLOW_REAL_DATA_LOCALLY="true"

# Optional model overrides
# GEMINI_MODEL="gemini-3.6-flash"
# Lighter model tried once if the primary is busy or times out ("none" disables)
# GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"
