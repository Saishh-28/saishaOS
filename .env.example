# Frontend (browser) settings, read by Vite at BUILD time.
# Copy to .env (git-ignored) for local development.
# Only VITE_* values end up in the browser bundle, so never put secrets here.
#
# Supabase > Project Settings > API:
#   - Project URL
#   - Publishable key (sb_publishable_...) or the legacy anon key. NEVER the secret / service_role key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# LOCAL TESTING (recommended): use a separate test Supabase project so
# testing never changes your real data. Put the TEST project's values in
# .env.development.local (git-ignored; only `npm run dev` reads it, never the
# deployed site), with this marker:
#   VITE_SUPABASE_URL="https://<test-project>.supabase.co"
#   VITE_SUPABASE_ANON_KEY="<test project's publishable key>"
#   VITE_SUPABASE_ENV="dev"
# Without VITE_SUPABASE_ENV="dev", `npm run dev` stops on a warning before it
# touches any data. Never set it in .env or in Cloudflare.

# Worker (server) secrets such as GEMINI_API_KEY do NOT go here.
# Put them in .dev.vars for local dev (see .dev.vars.example) and in
# Cloudflare with `npx wrangler secret put <NAME>` for production.
