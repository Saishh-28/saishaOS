# Frontend (browser) settings, read by Vite at BUILD time.
# Copy to .env (git-ignored) for local development.
# Only VITE_* values end up in the browser bundle, so never put secrets here.
#
# Supabase > Project Settings > API:
#   - Project URL
#   - Publishable key (sb_publishable_...) or the legacy anon key. NEVER the secret / service_role key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Worker (server) secrets such as GEMINI_API_KEY do NOT go here.
# Put them in .dev.vars for local dev (see .dev.vars.example) and in
# Cloudflare with `npx wrangler secret put <NAME>` for production.
